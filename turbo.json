{
  "$schema": "https://v2-10-4.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.*local"],
  "globalEnv": [
    "SUPABASE_SECRET_KEY",
    "SUPABASE_CPF_PEPPER",
    "CLIENT_SESSION_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NODE_ENV",
    "CONSOLE_BASE_DOMAIN",
    "STORE_BASE_DOMAIN",
    "RESEND_API_KEY",
    "SENTRY_AUTH_TOKEN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:types": {
      "cache": false,
      "outputs": ["packages/database/src/types.ts"]
    },
    "@vercel/*": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
